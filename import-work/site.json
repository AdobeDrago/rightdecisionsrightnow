{
 "name": "rightdecisionsrightnow",
 "source": {
  "origin": "http://rightdecisionsrightnow.com"
 },
 "rebuild": {
  "origin": "http://localhost:3000",
  "preview": "https://{ref}--rightdecisionsrightnow--adobedrago.aem.page",
  "repo": "..",
  "da": {
   "org": "AdobeDrago",
   "site": "rightdecisionsrightnow"
  }
 },
 "access": {
  "mode": "live",
  "header": null,
  "headerEnv": "EPR_ALLOW_HEADER",
  "origin": null,
  "profileDir": "work/.browser-profile",
  "cdpEnv": "CHROME_CDP_URL"
 },
 "widths": [
  1440
 ],
 "height": 900,
 "blockRequests": [],
 "sectionRoot": {},
 "hide": [],
 "invisible": [],
 "hideByText": [],
 "freezeCss": [],
 "hideIframes": true,
 "consent": true,
 "video": {
  "providers": "all"
 },
 "carousels": [
  "slick",
  "swiper",
  "hook"
 ],
 "scroll": {
  "max": 30000,
  "step": 500,
  "wait": 150
 },
 "closeExpanded": "header [aria-expanded=\"true\"]",
 "variantGuard": null,
 "prepare": [],
 "beforeSection": {
  "testimonials": {
   "source": [
    {
     "click": "button[aria-label='Go to page 1']#0"
    },
    {
     "wait": 800
    },
    {
     "js": "document.querySelector('header').style.visibility='hidden'"
    }
   ],
   "rebuild": []
  }
 },
 "report": {},
 "gate": {
  "pixel": 0.99,
  "tolerance": 0.5,
  "threshold": 0.1
 }
}